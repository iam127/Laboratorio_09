@model LaboratorioCRUDProductos.Models.ProductoModel

@{
    ViewBag.Title = "Editar producto";
}

<h2>Editar producto</h2>
<hr />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(m => m.Id)

    <div class="mb-3 row">
        @Html.LabelFor(m => m.Nombre, new { @class = "col-sm-2 col-form-label" })
        <div class="col-sm-10">
            @Html.EditorFor(m => m.Nombre, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="mb-3 row">
        @Html.LabelFor(m => m.Descripcion, new { @class = "col-sm-2 col-form-label" })
        <div class="col-sm-10">
            @Html.EditorFor(m => m.Descripcion, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="mb-3 row">
        @Html.LabelFor(m => m.Precio, new { @class = "col-sm-2 col-form-label" })
        <div class="col-sm-10">
            @Html.EditorFor(m => m.Precio, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(m => m.Precio, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="mb-3 row">
        @Html.LabelFor(m => m.Stock, new { @class = "col-sm-2 col-form-label" })
        <div class="col-sm-10">
            @Html.EditorFor(m => m.Stock, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(m => m.Stock, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="row">
        <div class="offset-sm-2 col-sm-10">
            <input type="submit" value="Actualizar" class="btn btn-warning" />
            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}